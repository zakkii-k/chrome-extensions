{
  "manifest_version": 3,
  "name": "New Tab Launcher",
  "version": "0.2.2",
  "description": "入力してから新しいタブへ。既存のタブを維持する検索ランチャー。",
  "minimum_chrome_version": "127",
  "permissions": [
    "activeTab",
    "scripting",
    "search",
    "tabs"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "New Tab Launcher",
    "default_popup": "popup.html"
  },
  "commands": {
    "open-launcher": {
      "suggested_key": {
        "default": "Ctrl+Shift+Space",
        "mac": "Command+Shift+Space"
      },
      "description": "検索バーを表示する"
    }
  },
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "frame.html"
      ],
      "matches": [
        "http://*/*",
        "https://*/*"
      ]
    }
  ]
}
