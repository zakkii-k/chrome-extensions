{
  "name": "chrome-extensions",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "chrome-extensions",
      "workspaces": [
        "extensions/*"
      ],
      "engines": {
        "node": ">=22"
      }
    },
    "extensions/link-peek": {
      "name": "@zakkii-k/link-peek",
      "version": "0.1.2"
    },
    "extensions/new-tab-launcher": {
      "name": "@zakkii-k/new-tab-launcher",
      "version": "0.2.1"
    },
    "node_modules/@zakkii-k/link-peek": {
      "resolved": "extensions/link-peek",
      "link": true
    },
    "node_modules/@zakkii-k/new-tab-launcher": {
      "resolved": "extensions/new-tab-launcher",
      "link": true
    }
  }
}
